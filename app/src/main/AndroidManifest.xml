<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permission to vibrate the phone -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Permission to send the webhook -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/transparent_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoDisplay">

        <!-- The Glance Widget Receiver -->
        <receiver
            android:name=".HeartbeatWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heartbeat_widget_info" />
        </receiver>

        <!-- The FCM Service for background wakeups -->
        <service
            android:name=".HeartbeatFcmService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
